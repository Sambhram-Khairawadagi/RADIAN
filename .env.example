# Use an HTTPS origin on deployment; leave blank for local-only previews.
NEXT_PUBLIC_SITE_URL=
# Keep false until the owner has approved all items in docs/PRODUCTION-READINESS.md.
NEXT_PUBLIC_LAUNCH_APPROVED=false
# Server-side lead delivery. Supabase is deliberately not required.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=
# Required in production for shared rate limiting (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# Only set true on a platform with a trusted x-forwarded-for header, e.g. Vercel.
TRUST_PROXY=false
